<riot-particles>
    <script>
        import { tsParticles } from "@tsparticles/engine";

        let initialized = false;
        let initPromise;
        let initCallback;

        export async function initParticlesEngine(cb) {
            if (initialized) {
                return;
            }

            if (initPromise) {
                if (initCallback !== cb) {
                    throw new Error("initParticlesEngine callback must be stable across the app lifecycle.");
                }

                await initPromise;

                return;
            }

            initCallback = cb;
            initPromise = (async () => {
                if (cb) {
                    await cb(tsParticles);
                }

                await tsParticles.init();
                initialized = true;
            })().catch((error) => {
                initPromise = undefined;
                initCallback = undefined;
                initialized = false;

                throw error;
            });

            await initPromise;
        }

        export function isParticlesEngineInitialized() {
            return initialized;
        }

        export async function waitForParticlesEngineInitialization() {
            await (initPromise ? initPromise : Promise.resolve());
        }

        async function loadParticles(tag, props) {
            const currentLoadId = ++tag.loadId;

            if (!props.id) {
                if (props.particlesLoaded) {
                    props.particlesLoaded(undefined);
                }
                return;
            }

            const newContainer = await tsParticles.load({
                id: props.id,
                options: props.options,
                url: props.url,
            });

            if (currentLoadId !== tag.loadId) {
                newContainer?.destroy();
                return;
            }

            tag.container = newContainer;
            tag.prevId = props.id;
            tag.prevOptions = props.options;
            tag.prevUrl = props.url;
            tag.prevTheme = props.theme;

            if (newContainer && props.theme) {
                newContainer?.loadTheme?.(props.theme);
            }

            if (props.particlesLoaded) {
                props.particlesLoaded(newContainer);
            }
        }

        export default {
            async onMounted(props) {
                await waitForParticlesEngineInitialization();

                if (!isParticlesEngineInitialized()) {
                    throw new Error("initParticlesEngine(...) must be called once before mounting <riot-particles /> components.");
                }

                this.container = undefined;
                this.loadId = 0;
                this.mounted = true;
                this.prevId = undefined;
                this.prevOptions = undefined;
                this.prevTheme = undefined;
                this.prevUrl = undefined;

                await loadParticles(this, props);
            },
            onUnmounted() {
                this.mounted = false;
                this.loadId++;

                this.container?.destroy();
                this.container = undefined;
            },
            async onUpdated(props) {
                if (!this.mounted) {
                    return;
                }

                const idChanged = props.id !== this.prevId;
                const optionsChanged = props.options !== this.prevOptions;
                const urlChanged = props.url !== this.prevUrl;
                const themeChanged = props.theme !== this.prevTheme;

                if (idChanged || optionsChanged || urlChanged) {
                    this.container?.destroy();
                    this.container = undefined;

                    await loadParticles(this, props);
                } else if (themeChanged && this.container) {
                    this.container?.loadTheme?.(props.theme);

                    this.prevTheme = props.theme;
                } else {
                    this.prevId = props.id;
                    this.prevOptions = props.options;
                    this.prevUrl = props.url;
                    this.prevTheme = props.theme;
                }
            },
        }
    </script>
    <div id="{props.id}"></div>

</riot-particles>
