<riot-particles>
    <script>
const states = new WeakMap();
function getInitializationState(engine) {
    const existing = states.get(engine);
    if (existing) {
        return existing;
    }
    let resolve = () => { }, reject = (_error) => { };
    const promise = new Promise((onResolve, onReject) => {
        resolve = onResolve;
        reject = onReject;
    });
    const state = { loaded: false, started: false, promise, resolve, reject };
    states.set(engine, state);
    return state;
}
export async function initParticlesEngine(engine, init) {
    const state = getInitializationState(engine);
    if (!state.started) {
        state.started = true;
        void Promise.resolve().then(async () => {
            await init?.(engine);
            await engine.init();
            state.loaded = true;
            state.resolve();
        }).catch((error) => {
            states.delete(engine);
            state.reject(error);
        });
    }
    return state.promise;
}
export function isParticlesEngineInitialized(engine) {
    return states.get(engine)?.loaded ?? false;
}
export async function waitForParticlesEngineInitialization(engine) {
    await getInitializationState(engine).promise;
}
        async function loadParticles(tag, props) {
            const currentLoadId = ++tag.loadId;

            if (!props.id) {
                if (props.particlesLoaded) {
                    props.particlesLoaded(undefined);
                }
                return;
            }

            const newContainer = await props.engine.load({
                id: props.id,
                options: props.options,
                url: props.url,
            });

            if (currentLoadId !== tag.loadId) {
                newContainer?.destroy();
                return;
            }

            tag.container = newContainer;
            tag.prevEngine = props.engine;
            tag.prevId = props.id;
            tag.prevOptions = props.options;
            tag.prevUrl = props.url;
            tag.prevTheme = props.theme;

            if (newContainer && props.theme) {
                newContainer?.loadTheme?.(props.theme);
            }

            if (props.particlesLoaded) {
                props.particlesLoaded(newContainer);
            }
        }

        export default {
            async onMounted(props) {
                await waitForParticlesEngineInitialization(props.engine);

                if (!isParticlesEngineInitialized(props.engine)) {
                    throw new Error("initParticlesEngine(...) must be called once before mounting <riot-particles /> components.");
                }

                this.container = undefined;
                this.loadId = 0;
                this.mounted = true;
                this.prevId = undefined;
                this.prevOptions = undefined;
                this.prevTheme = undefined;
                this.prevUrl = undefined;

                await loadParticles(this, props);
            },
            onUnmounted() {
                this.mounted = false;
                this.loadId++;

                this.container?.destroy();
                this.container = undefined;
            },
            async onUpdated(props) {
                if (!this.mounted) {
                    return;
                }

                const idChanged = props.id !== this.prevId;
                const optionsChanged = props.options !== this.prevOptions;
                const urlChanged = props.url !== this.prevUrl;
                const themeChanged = props.theme !== this.prevTheme;

                if (props.engine !== this.prevEngine || idChanged || optionsChanged || urlChanged) {
                    this.container?.destroy();
                    this.container = undefined;

                    await loadParticles(this, props);
                } else if (themeChanged && this.container) {
                    this.container?.loadTheme?.(props.theme);

                    this.prevTheme = props.theme;
                } else {
                    this.prevId = props.id;
                    this.prevOptions = props.options;
                    this.prevUrl = props.url;
                    this.prevTheme = props.theme;
                }
            },
        }
    </script>
    <div id="{props.id}"></div>

</riot-particles>
