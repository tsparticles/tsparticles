{
  "name": "@tsparticles/template-scaffold",
  "version": "4.3.3",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsparticles/tsparticles.git",
    "directory": "templates/scaffold"
  },
  "scripts": {
    "prebuild": "node scripts/prebuild.js",
    "build": "pnpm run prebuild",
    "build:ci": "pnpm run prebuild",
    "version": "pnpm run build && git add template.json",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@tsparticles/engine": "workspace:*",
    "@tsparticles/slim": "workspace:*",
    "@tsparticles/configs": "workspace:*"
  },
  "devDependencies": {
    "fs-extra": "^11.3.4"
  }
}
